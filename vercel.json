{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron-cycle",
      "schedule": "0 0 * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/cron-cycle",
      "dest": "/api/cron-cycle.js"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/dossiers/(.*)",
      "dest": "/public/dossiers/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
